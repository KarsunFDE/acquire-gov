# acquire-gov — environment template
# Copy to .env and fill in real values. .env is git-ignored.

# --- Auth / JWT ---
JWT_ISSUER_URI=http://localhost:8090/auth
JWT_AUDIENCE=acquire-gov

# --- Datastores ---
POSTGRES_URL=jdbc:postgresql://localhost:5432/acquire_gov
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password

MONGO_URL=mongodb://app:app_dev_password@localhost:27017
MONGO_DB=acquire_gov

# --- AWS / Bedrock ---
AWS_REGION=us-east-1
# Pick ONE auth path:
#  (A) Bedrock API key (recommended) — single bearer token w/ built-in expiry.
#      Generate: Bedrock console > API keys > Generate (set expiry). Needs
#      boto3 >= 1.39.11; auto-used by boto3, no code change.
AWS_BEARER_TOKEN_BEDROCK=
#  (B) Long-lived IAM access key/secret (works with any boto3, weaker hygiene).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ⚠ pinned a generation behind current GA on purpose (cohort updates this).
BEDROCK_MODEL_ID=anthropic.claude-3-7-sonnet-20250219-v1:0

# --- M1 agentic drafting (ADR-0012/0013/0014/0015) ---
# Lightweight extractor model for extract_section_requirements (ADR-0012 D2).
BEDROCK_EXTRACT_MODEL=amazon.nova-lite-v1:0
# Structured-output retry budget for the extractor (second failure → degraded empty result).
BEDROCK_EXTRACT_MAX_RETRIES=1
# Consistency-critic model (ADR-0013 D4).
BEDROCK_CRITIC_MODEL=amazon.nova-lite-v1:0
# True → extra Section K clauses beyond the set-aside's required list raise warn.
SET_ASIDE_STRICT_EXTRA=false
# Rerank-score gate thresholds (ADR-0012 D6): score >= pass → draft; [withhold, pass) → HITL; < withhold → withheld.
GATE_PASS_THRESHOLD=0.55
GATE_WITHHOLD_THRESHOLD=0.40
# Mongo collections backing the LangGraph checkpointer (ADR-0012 D4; TTL is code-pinned to None).
AGENT_CHECKPOINT_COLLECTION=agent_checkpoints
AGENT_CHECKPOINT_WRITES_COLLECTION=agent_checkpoint_writes
# Orphan-thread sweeper cadence + age cutoff (ADR-0012 D8.2).
AGENT_ORPHAN_SWEEP_INTERVAL_SECONDS=3600
AGENT_ORPHAN_AGE_DAYS=30
# Hard cap on coordinator fan-out per batch invocation (ADR-0014 D9 — count of AI-draftable Parts).
MAX_BATCH_FAN_OUT=2
# LangSmith tracing (ADR-0012 D7) — all optional; tracing disables gracefully when unset.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=acquire-gov-m1-draft

# --- Inter-service ---
API_GATEWAY_URL=http://localhost:8080
SOLICITATION_SERVICE_URL=http://localhost:8081
EVALUATION_SERVICE_URL=http://localhost:8082
AI_ORCHESTRATOR_URL=http://localhost:8000
