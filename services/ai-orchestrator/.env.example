# ai-orchestrator — environment variable template.
#
# Copy to repo-root .env (docker-compose reads it with required: false so
# absence is OK — stub fallbacks cover dev). Source-of-truth for the
# constants below is services/ai-orchestrator/app/config.py + spec §10/§11
# (docs/specs/m2-retrieval-pipeline.md).
#
# ⚠ DELIBERATE BROWNFIELD: BEDROCK_MODEL_ID drift across three places
# (.env.example, docker-compose.yml environment:, bedrock_client.py) is
# preserved. Cohort consolidates in W2. BEDROCK_GEN_MODEL below is the
# new M2 source of truth for the generator (ADR-0010 D3 note).

# --- AWS / Bedrock auth -----------------------------------------------------
# Preferred: bearer-token auth. boto3 1.39.11+ auto-uses this for any
# bedrock-* client when set. No code change required.
AWS_BEARER_TOKEN_BEDROCK=

# IAM access-key/secret fallback (works alongside bearer auth).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Default region. Rerank-1.0 is hardcoded to us-west-2 below; chat/embed
# inherit AWS_REGION. cross-region inference profile on the chat model
# routes us-east-1 → us-west-2 transparently.
AWS_REGION=us-east-1

# --- Bedrock models (ADR-0003 / ADR-0005 D2 / ADR-0007 D3 / ADR-0009 D2) ---
BEDROCK_GEN_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIMS=512
BEDROCK_RERANK_MODEL_ARN=arn:aws:bedrock:us-west-2::foundation-model/amazon.rerank-v1:0
# Rerank 1.0 is NOT available in us-east-1 (spec §11). This is the one
# infrastructure knob operators can misconfigure.
BEDROCK_RERANK_REGION=us-west-2
# Eval-side only (Nova Micro as the RAGAS judge / guardrail LLM).
BEDROCK_JUDGE_MODEL=amazon.nova-micro-v1:0

# Legacy brownfield generator id — kept for the existing /draft-* stub
# endpoints. Cohort consolidates in W2. Do NOT remove.
BEDROCK_MODEL_ID=anthropic.claude-3-7-sonnet-20250219-v1:0

# --- Mongo (ADR-0005 D3 / ADR-0008 D5) -------------------------------------
# atlas-local 8.0.8 requires ?directConnection=true (driver otherwise
# tries to discover a replica set and times out).
MONGO_URI=mongodb://user:pass@mongodb:27017/?directConnection=true
MONGO_DB=acquire_gov
CHUNKS_COLLECTION=chunks
AUDIT_LOG_COLLECTION=audit_log
VECTOR_INDEX_NAME=far_vector_idx
SEARCH_INDEX_NAME=far_search_idx

# --- Retrieval / rerank knobs (ADR-0007 D2) --------------------------------
RETRIEVAL_K_CANDIDATES=20
RERANK_TOP_N=5
RERANK_WITHHOLD_THRESHOLD=0.3
RERANK_HITL_THRESHOLD=0.5

# --- Guardrails + rate limits (ADR-0011 D2 / D4) ---------------------------
MAX_QUERY_CHARS=2000
MAX_RESPONSE_CHARS=8000
RATE_LIMIT_QUERIES_PER_MINUTE_PER_TENANT=30
RATE_LIMIT_QUERIES_PER_DAY_PER_TENANT=1000

# --- Observability guards (ADR-0009 D3) ------------------------------------
# NEVER set to true in Phase 1 — LangSmith is the never-on guard.
# Bedrock model-invocation logging is also off by design (spec §14).
LANGSMITH_TRACING=false
